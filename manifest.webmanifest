{
  "id": "/dashboard",
  "name": "SpendNote",
  "short_name": "SpendNote",
  "description": "Cash receipts and petty cash tracking for small teams.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#059669",
  "categories": ["business", "finance", "productivity"],
  "icons": [
    { "src": "/assets/images/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/images/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/images/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "New transaction",
      "short_name": "New",
      "url": "/spendnote-new-transaction",
      "icons": [{ "src": "/assets/images/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Transactions",
      "url": "/spendnote-transaction-history",
      "icons": [{ "src": "/assets/images/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
